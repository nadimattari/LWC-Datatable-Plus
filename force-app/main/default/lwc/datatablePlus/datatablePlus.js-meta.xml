<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
	<apiVersion>68.0</apiVersion>
	<isExposed>true</isExposed>
	<masterLabel>Datatable Plus</masterLabel>
	<description>Reusable datatable shell with Apex-backed rows and query states.</description>
	<targets>
		<target>lightning__AppPage</target>
		<target>lightning__HomePage</target>
		<target>lightning__RecordPage</target>
	</targets>
	<targetConfigs>
		<targetConfig targets="lightning__AppPage, lightning__HomePage, lightning__RecordPage">
			<property name="objectApiName" type="String" label="Object API Name" required="true" />
			<property name="keyField" type="String" label="Key Field" default="Id" />
			<property name="pageSize" type="Integer" label="Page Size" default="20" min="1" max="200" />
			<property name="title" type="String" label="Title" />
		</targetConfig>
	</targetConfigs>
</LightningComponentBundle>
